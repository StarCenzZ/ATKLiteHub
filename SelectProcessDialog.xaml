<Window x:Class="ATKLiteHub.SelectProcessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择正在运行的应用程序"
        Width="440" Height="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border CornerRadius="12" Background="#12141A" BorderBrush="#262933" BorderThickness="1.5" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Color="#000000" Opacity="0.8" ShadowDepth="8"/>
        </Border.Effect>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title -->
                <RowDefinition Height="Auto"/> <!-- Filter / Search -->
                <RowDefinition Height="*"/>    <!-- Process List -->
                <RowDefinition Height="Auto"/> <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Title -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="3" Height="18" Background="#FF4E27" CornerRadius="1.5" Margin="0,0,8,0"/>
                    <TextBlock Text="从当前运行程序中选择" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                </StackPanel>
                <Button Click="BtnCancel_Click" HorizontalAlignment="Right" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" CornerRadius="4">
                                <TextBlock Text="✕" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Search Filter -->
            <Border Grid.Row="1" Background="#1A1D24" BorderBrush="#2B303C" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍 " FontSize="12" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtSearch" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF"
                             FontSize="12" VerticalAlignment="Center" TextChanged="TxtSearch_TextChanged"
                             CaretBrush="#FF4E27"/>
                </Grid>
            </Border>

            <!-- Process List -->
            <Border Grid.Row="2" Background="#101115" BorderBrush="#22252E" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,0,14">
                <ListBox x:Name="ListProcesses" Background="Transparent" BorderThickness="0" Foreground="#E2E8F0"
                         MouseDoubleClick="ListProcesses_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⚡" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#FF4E27"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProcessName}" Foreground="#F1F5F9" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Title}" Foreground="#64748B" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding ExeName}" Foreground="#475569" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Buttons -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtCount" Grid.Column="0" Text="0 个程序" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Click="BtnCancel_Click" Content="取消" Width="72" Height="32" Background="#1E2129" Foreground="#94A3B8" BorderBrush="#2F3442" BorderThickness="1" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Grid.Column="3" Click="BtnSelect_Click" Content="确定添加" Width="84" Height="32" Background="#FF4E27" Foreground="#FFFFFF" BorderBrush="#FF6F4E" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
