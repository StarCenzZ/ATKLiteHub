<Window x:Class="ATKLiteHub.ProfileToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ATK Profile Toast" 
        Height="84" Width="330"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <Window.Resources>
        <Storyboard x:Key="FadeInStory">
            <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="TranslateTransform" Storyboard.TargetProperty="Y" From="18" To="0" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="FadeOutStory">
            <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" From="1.0" To="0.0" Duration="0:0:0.25"/>
            <DoubleAnimation Storyboard.TargetName="TranslateTransform" Storyboard.TargetProperty="Y" From="0" To="12" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Border x:Name="RootBorder" Margin="6" Background="#F513151B" CornerRadius="10" BorderThickness="1.2" Cursor="Hand">
        <Border.BorderBrush>
            <SolidColorBrush x:Name="CardBorderBrush" Color="#FF4E27"/>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="3" Opacity="0.55"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="TranslateTransform" Y="0"/>
        </Border.RenderTransform>

        <Grid Margin="12,8,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Badge -->
            <Border x:Name="BadgeBorder" Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="#26FF4E27" Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtBadge" Text="P2" FontWeight="Bold" FontSize="18" Foreground="#FF4E27" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TxtTitle" Text="已切换至 板载配置 2 (游戏电竞)" FontWeight="Bold" FontSize="13" Foreground="#F3F4F6"/>
                <TextBlock x:Name="TxtSubtitle" Text="游戏守护自动触发" FontSize="11" Foreground="#9CA3AF" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>