<Window x:Class="ATKLiteHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ATK HUB LITE"
        Width="520" Height="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Thin scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#2A2E37" CornerRadius="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#16181D"/>
            <Setter Property="BorderBrush" Value="#1F2228"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,4,0,8"/>
        </Style>

        <!-- Toggle switch -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="40" Height="22" CornerRadius="11" Background="#2A2E37">
                            <Border x:Name="Knob" Width="16" Height="16" CornerRadius="8" Background="#9CA3AF"
                                    HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="KnobX"/>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#FF4E27"/>
                                <Setter TargetName="Knob" Property="Background" Value="#FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobX" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobX" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented profile button -->
        <Style x:Key="SegButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small icon button -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#23262E"/>
                                <Setter Property="Foreground" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5484D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Process list item -->
        <Style x:Key="ProcItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,8" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1C1F25"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#23262E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" Background="#0E0F12" BorderBrush="#22252C" BorderThickness="1"
            Margin="12" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Color="#000000" Opacity="0.6" ShadowDepth="4"/>
        </Border.Effect>

        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="3" Height="18" Background="#FF4E27" CornerRadius="1.5" Margin="0,0,10,0"/>
                    <TextBlock Text="ATK HUB" Foreground="#F9FAFB" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="LITE" Foreground="#FF4E27" FontSize="16" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE921;" FontSize="10" Click="BtnMinimize_Click" ToolTip="最小化到托盘"/>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Margin="4,0,0,0" Click="BtnClose_Click" ToolTip="隐藏到托盘"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-10,0" Padding="0,0,10,0">
                <StackPanel>

                    <!-- Devices -->
                    <TextBlock Text="设备" Style="{StaticResource SectionLabel}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <!-- Mouse -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="10" Background="#1F2228" Margin="0,0,14,0">
                                    <TextBlock Text="&#xE962;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="#E5E7EB"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="ATK A9 Ultimate" Foreground="#F3F4F6" FontSize="14" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Ellipse x:Name="DotMouse" Width="6" Height="6" Fill="#4B5563" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="TxtMouseStatus" Text="连接中…" Foreground="#8B93A1" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="76">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock x:Name="IcoMouseCharging" Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="13"
                                                   Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,4,0" Visibility="Collapsed"/>
                                        <TextBlock x:Name="TxtMousePercent" Text="--" Foreground="#F9FAFB" FontSize="22" FontWeight="Bold"/>
                                        <TextBlock Text="%" Foreground="#6B7280" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                    </StackPanel>
                                    <ProgressBar x:Name="PbMouse" Maximum="100" Value="0" Height="4" Margin="0,4,0,0"
                                                 Background="#262A33" Foreground="#22C55E" BorderThickness="0"/>
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="#1F2228" Margin="0,14"/>

                            <!-- Headset -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="10" Background="#1F2228" Margin="0,0,14,0">
                                    <TextBlock Text="&#xE7F6;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="#E5E7EB"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="HyperX Cloud III Wireless" Foreground="#F3F4F6" FontSize="14" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Ellipse x:Name="DotHeadset" Width="6" Height="6" Fill="#4B5563" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="TxtHeadsetStatus" Text="连接中…" Foreground="#8B93A1" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="76">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock x:Name="IcoHeadsetCharging" Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="13"
                                                   Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,4,0" Visibility="Collapsed"/>
                                        <TextBlock x:Name="TxtHeadsetPercent" Text="--" Foreground="#F9FAFB" FontSize="22" FontWeight="Bold"/>
                                        <TextBlock Text="%" Foreground="#6B7280" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                    </StackPanel>
                                    <ProgressBar x:Name="PbHeadset" Maximum="100" Value="0" Height="4" Margin="0,4,0,0"
                                                 Background="#262A33" Foreground="#22C55E" BorderThickness="0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Profile -->
                    <TextBlock Text="板载配置" Style="{StaticResource SectionLabel}"/>
                    <Border Style="{StaticResource Card}" Padding="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnProfile1" Grid.Column="0" Style="{StaticResource SegButton}" Click="BtnSwitchProfile1_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F8;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="配置 1 · 日常" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnProfile2" Grid.Column="2" Style="{StaticResource SegButton}" Click="BtnSwitchProfile2_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="配置 2 · 游戏" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Game guard -->
                    <TextBlock Text="游戏守护" Style="{StaticResource SectionLabel}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="游戏运行时锁定配置 2" Foreground="#F3F4F6" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="按进程判断，切屏不会跳回" Foreground="#8B93A1" FontSize="12" Margin="0,3,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkAutoSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          IsChecked="True" Checked="ChkAutoSwitch_Changed" Unchecked="ChkAutoSwitch_Changed"/>
                            </Grid>

                            <Border Height="1" Background="#1F2228" Margin="0,14,0,10"/>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="关联程序" Foreground="#9CA3AF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE8E5;" Click="BtnAddProcessFile_Click" ToolTip="浏览 .exe"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE71D;" Margin="2,0,0,0" Click="BtnAddRunningProcess_Click" ToolTip="从运行中的程序选择"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Margin="2,0,0,0" Click="BtnRemoveProcess_Click" ToolTip="移除选中项"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <ListBox x:Name="ListProcesses" MinHeight="44" MaxHeight="168" Background="Transparent" BorderThickness="0"
                                         ItemContainerStyle="{StaticResource ProcItem}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                                           Foreground="{Binding IconColor}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#E5E7EB" FontSize="13" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="12" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="TxtEmptyList" Text="还没有关联程序" Foreground="#4B5563" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Startup -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,0">
                        <Grid>
                            <TextBlock Text="开机自启（静默到托盘）" Foreground="#F3F4F6" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkAutoStart" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="ChkAutoStart_Changed" Unchecked="ChkAutoStart_Changed"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,14,0,0">
                <Ellipse x:Name="DotStatus" Width="6" Height="6" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtStatusTip" Text="守护中" Foreground="#8B93A1" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
